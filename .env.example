# ==============================================================================
# AI Chatbot Platform — Environment Configuration Template
# ==============================================================================
# WARNING: Do not put real secrets or credentials in this file.
# Copy this file to `.env` for local development and supply your actual values.
# `.env` is ignored by Git and must never be committed.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5050

# Reverse Proxy Trust (Set to 1 or true when deployed behind Cloudflare, Nginx, AWS ALB, Render)
# TRUST_PROXY=1

# Client Application URL (used for CORS and CSRF origin validation for admin routes)
# The public chat and leads APIs are open to any origin so that widgets work on customer sites.
FRONTEND_URL=http://localhost:5173

# Optional: Comma-separated list of additional allowed admin origins in production
# ALLOWED_ORIGINS=https://admin.yourplatform.com,https://staging.yourplatform.com

# Frontend Build API URL (Used by Vite when building the frontend static bundle)
# If frontend is hosted on a separate domain from the backend API, set this at build time:
# VITE_API_BASE_URL=https://api.yourplatform.com

# MongoDB Atlas Configuration
# Obtain connection string from your MongoDB Atlas dashboard:
# Cluster -> Connect -> Drivers (Node.js) -> View connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_chatbot_platform

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_random_characters
JWT_EXPIRES_IN=24h
ADMIN_COOKIE_NAME=admin_token

# Cookie Options for Cross-Domain or Custom Deployments (Optional)
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourplatform.com

# Initial Admin Setup Seed (Optional for CLI script: npm run create-admin)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_strong_password_min_8_chars

# Local model service (server-side only)
# In production, ensure OLLAMA_BASE_URL is reachable by the backend over a secure private network.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=30000
OLLAMA_OUTPUT_TOKENS=300
